# Cell 8: Plot scale comparison
import json, numpy as np
import matplotlib
matplotlib.use("Agg")
import matplotlib.pyplot as plt

scale_dir = "/kaggle/working/RSI/artifacts/scale"
trajectories = {}

for model_name, label in [("1_5b", "1.5B"), ("3b", "3B"), ("7b", "7B")]:
    trajs = []
    for seed_dir in sorted(__import__("pathlib").Path(scale_dir).glob(f"{model_name}_s*")):
        result_file = seed_dir / "result.json"
        if result_file.exists():
            with open(result_file) as f:
                data = json.load(f)
            acc = [r["accuracy"] for r in data["result"]["rounds"]]
            trajs.append(acc)
    if trajs:
        mean = np.mean(trajs, axis=0)
        trajectories[label] = mean

# Plot
fig, ax = plt.subplots(figsize=(8, 5))
colors = {"1.5B": "#1f77b4", "3B": "#ff7f0e", "7B": "#2ca02c"}
for label, traj in trajectories.items():
    ax.plot(range(len(traj)), traj, marker="o", label=label, color=colors.get(label), linewidth=2)

ax.set_xlabel("Round", fontsize=12)
ax.set_ylabel("Test Accuracy", fontsize=12)
ax.set_title("H3: Capability Ceiling — Accuracy by Model Scale\n(Oracle verifier, STaR loop, GSM8K)", fontsize=13)
ax.legend(fontsize=11)
ax.grid(True, alpha=0.3)
fig.tight_layout()

out_path = "/kaggle/working/RSI/artifacts/scale/scale_comparison.png"
__import__("pathlib").Path(out_path).parent.mkdir(parents=True, exist_ok=True)
fig.savefig(out_path, dpi=150)
print(f"Saved: {out_path}")
plt.show()

