# Cell 3: Run 1.5B baseline (oracle, 5 rounds, 1 seed)
import subprocess, os
os.chdir("/kaggle/working/RSI")
result = subprocess.run(
    ["python", "scripts/run_loop.py", "--config", "configs/scale_1_5b.yaml"],
