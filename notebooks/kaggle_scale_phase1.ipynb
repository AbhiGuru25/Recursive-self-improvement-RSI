)
print(result.stdout[-3000:] if result.stdout else "no output")
if result.returncode != 0:
    print("ERROR:", result.stderr[-1000:])

# %%
# Cell 4: Plot trajectory
import json, numpy as np
import matplotlib
matplotlib.use("Agg")
import matplotlib.pyplot as plt
from pathlib import Path

result_file = Path("/kaggle/working/RSI/artifacts/scale/1_5b_s0/result.json")
if result_file.exists():
    with open(result_file) as f:
        data = json.load(f)
    acc = [r["accuracy"] for r in data["result"]["rounds"]]
    
    fig, ax = plt.subplots(figsize=(7, 5))
    ax.plot(range(len(acc)), acc, marker="o", color="#1f77b4", linewidth=2, markersize=8)
    ax.set_xlabel("Round", fontsize=12)
    ax.set_ylabel("Test Accuracy", fontsize=12)
    ax.set_title("1.5B Baseline — Oracle Verifier, STaR Loop\n(GSM8K, 5 rounds)", fontsize=13)
    ax.grid(True, alpha=0.3)
    for i, v in enumerate(acc):
        ax.annotate(f"{v:.3f}", (i, v), textcoords="offset points", xytext=(0, 10), ha="center", fontsize=10)
    fig.tight_layout()
    fig.savefig("/kaggle/working/RSI/artifacts/scale/1_5b_trajectory.png", dpi=150)
    plt.show()
    print(f"Trajectory: {acc}")
else:
    print("No result file found")

