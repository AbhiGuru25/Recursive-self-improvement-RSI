# Cell 5: Plot all scales comparison
import json, numpy as np
import matplotlib
matplotlib.use("Agg")
import matplotlib.pyplot as plt
from pathlib import Path

scale_dir = Path("/kaggle/working/RSI/artifacts/scale")
trajectories = {}

for model_key, label in [("1_5b", "1.5B"), ("3b", "3B"), ("7b", "7B")]:
    result_file = scale_dir / f"{model_key}_s0" / "result.json"
    if result_file.exists():
        with open(result_file) as f:
            data = json.load(f)
        acc = [r["accuracy"] for r in data["result"]["rounds"]]
        trajectories[label] = acc

if trajectories:
    fig, ax = plt.subplots(figsize=(8, 5))
    colors = {"1.5B": "#1f77b4", "3B": "#ff7f0e", "7B": "#2ca02c"}
    for label, acc in trajectories.items():
        ax.plot(range(len(acc)), acc, marker="o", label=label, color=colors[label], linewidth=2, markersize=8)
        for i, v in enumerate(acc):
            ax.annotate(f"{v:.3f}", (i, v), textcoords="offset points", xytext=(0, 10), ha="center", fontsize=9)

    ax.set_xlabel("Round", fontsize=12)
    ax.set_ylabel("Test Accuracy", fontsize=12)
    ax.set_title("H3: Capability Ceiling — Accuracy by Model Scale\n(Oracle verifier, STaR loop, GSM8K, 5 rounds)", fontsize=13)
    ax.legend(fontsize=11)
    ax.grid(True, alpha=0.3)
    fig.tight_layout()
    fig.savefig("/kaggle/working/RSI/artifacts/scale/scale_comparison.png", dpi=150)
    plt.show()
    
    print("\nScale comparison:")
    for label, acc in trajectories.items():
        print(f"  {label}: {acc}")
else:
    print("No results found")

